# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_WEB_CLIENT_ID: Your Google Cloud Web Client ID (from API Credentials)
# Set this to enable production Google / Gmail Sign In.
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID_PLACEHOLDER

# FACEBOOK_CLIENT_TOKEN: Your Facebook Developer App Client Token
# Set this once your Facebook App Business Verification is completed.
FACEBOOK_CLIENT_TOKEN=YOUR_FACEBOOK_CLIENT_TOKEN_PLACEHOLDER
